          Event: ORDER_PLACED        
          {
            event_id: "evt-123",
            transCode: "1001",        ← transaction code (mostly numerical, sometimes string)
            transType: "ORD",         ← transaction type
            channelId: "2",           ← kis upstream system ne event generate kiya (mobile banking / net banking etc)
            user_id: 101,
            order_id: "ORD-456",
            amount: 5000,
            timestamp: "..."
            ......
            ...other placeholders   ← jo template me populate honge (orderId, amount, name, etc.)
